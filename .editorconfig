# ARCHITECTURE DECISION: EditorConfig ensures consistent formatting across
# all editors and IDEs. Terraform uses 2-space indentation. Markdown uses
# 2-space indentation for list alignment.

root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.tf]
indent_size = 2
indent_style = space

[*.tfvars]
indent_size = 2
indent_style = space

[*.md]
indent_size = 2
trim_trailing_whitespace = false

[*.{json,yaml,yml}]
indent_size = 2
indent_style = space

[Makefile]
indent_style = tab

[*.go]
indent_size = 4
indent_style = tab
